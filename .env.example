# cp .env.example .env before running docker compose.
# --- LLM (OpenRouter) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_PRIMARY=z-ai/glm-4.5-air
OPENROUTER_MODEL_FALLBACK=minimax/minimax-m2
LLM_MODE=openrouter            # openrouter | fake (fake = deterministic scripted LLM, no network)

# --- AWS / Floci ---
FLOCI_STORAGE_MODE=persistent  # CI overrides to memory
FLOCI_STORAGE_PERSISTENT_PATH=/app/data
AWS_ENDPOINT_URL=http://floci:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=ap-southeast-1

# --- Ride provider (Uber adapter) ---
UBER_BASE_URL=http://mock-uber:8001
UBER_API_TOKEN=mock-token      # static bearer for MVP; real OAuth client-credentials at prod swap
UBER_ORG_UUID=mock-org-uuid
WEBHOOK_SHARED_SECRET=

# --- Geocoder (OneMap) ---
ONEMAP_BASE_URL=https://www.onemap.gov.sg
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

# --- Rider identity (single-user MVP; PII - server-side only, never in LLM context) ---
RIDER_FIRST_NAME=Demo
RIDER_LAST_NAME=Rider
RIDER_PHONE=+6591234567

# --- mock-uber simulator ---
SIM_SPEED=1.0                  # divide lifecycle delays by this; 2.0 = twice as fast
MOCK_DETERMINISTIC=0           # 1 = instant transitions + fixed fares (tests)
WEBHOOK_TARGET_URL=http://api:8000/webhooks/uber
